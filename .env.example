# Drizzle / Turso
# Local dev: a plain file works fine.
DATABASE_URL=file:local.db
# Production (Turso remote db): use libsql://... URL + its auth token.
# DATABASE_AUTH_TOKEN=

# Shared secret the ESP32 must send as the `x-api-key` header on POST /api/ingest
INGEST_API_KEY=change-me-to-a-long-random-string

# --- Login (Google sign-in) ---
# Random secret Auth.js uses to sign session cookies/tokens. Generate one
# with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# From Google Cloud Console > APIs & Services > Credentials > OAuth Client ID.
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# Comma-separated list of Gmail addresses allowed to sign in. This is the
# real access gate - checked server-side regardless of what Google's own
# consent screen "Testing" mode does or doesn't restrict.
ALLOWED_EMAILS=you@gmail.com,family-member@gmail.com

# --- Monthly data rotation ---
# Random secret Vercel Cron sends back as `Authorization: Bearer <this>`
# when it triggers /api/cron/rotate-readings on the schedule in
# vercel.json. Generate one the same way as AUTH_SECRET.
CRON_SECRET=change-me-to-a-long-random-string
