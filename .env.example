# Drizzle / Turso
# Local dev: a plain file works fine.
DATABASE_URL=file:local.db
# Production (Turso remote db): use libsql://... URL + its auth token.
# DATABASE_AUTH_TOKEN=

# Shared secret the ESP32 must send as the `x-api-key` header on POST /api/ingest
INGEST_API_KEY=change-me-to-a-long-random-string
