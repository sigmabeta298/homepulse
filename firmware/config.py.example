# Copy this file to config.py and fill in real values.
# config.py is gitignored - never commit real WiFi credentials or your API key.

# --- WiFi ---
WIFI_SSID = "your-wifi-name"
WIFI_PASSWORD = "your-wifi-password"

# --- HomePulse server ---
# Local testing (same WiFi network as your dev machine):
#   API_BASE_URL = "http://192.168.1.50:5173"   # your computer's LAN IP + dev port
# Production (once deployed to Vercel):
#   API_BASE_URL = "https://your-project.vercel.app"
API_BASE_URL = "http://192.168.1.50:5173"

# Must match INGEST_API_KEY in the web app's .env / Vercel env vars.
INGEST_API_KEY = "change-me-to-match-your-server"

# Identifies this physical board. The server auto-creates a device with
# this slug on first reading. Keep this as "homepulse" - there's only one
# physical device, per the project's design.
DEVICE_SLUG = "homepulse"

# --- Capture mode fallback ---
# The ESP32 fetches the current mode from the web app every 15 seconds.
# Change the mode in the web app's Settings page; no config copy is needed.
# This local value is used only if the app cannot be reached after boot.
MODE = "continuous"

# How often continuous mode takes and sends a reading.
CONTINUOUS_INTERVAL_SECONDS = 300  # 5 minutes

# --- Pins ---
# Defaults below assume nothing's wired yet - change these to match your
# actual breadboard layout. Avoid GPIO 0, 3, 26-32, 35-37, 45, 46 on the
# ESP32-S3 N16R8 (strapping pins / reserved for flash & PSRAM).
DHT22_PIN = 4

# Set to True once the PMS5003 is actually wired in. Leave False to run
# DHT22-only (temp/humidity) without the firmware trying to talk to a
# sensor that isn't connected yet.
ENABLE_PMS5003 = False

PMS5003_UART_ID = 1
PMS5003_TX_PIN = 17
PMS5003_RX_PIN = 18

# Only relevant in "spot" mode. Wire one leg of a push button here, the
# other leg to GND. Internal pull-up is enabled in code, so no resistor
# needed on the breadboard.
CAPTURE_BUTTON_PIN = 5
